<Project Sdk="Microsoft.VisualStudio.JavaScript.Sdk/1.0.7204101">
    <PropertyGroup>
        <Platforms>AnyCPU;Any CPU</Platforms>
        <!-- Commande lancée par l'IDE pour démarrer le front -->
        <StartupCommand>npm run dev</StartupCommand>
        <!-- Le build Vite écrit dans dist/, servi par nginx (voir deploy/nginx) -->
        <BuildOutputFolder>$(MSBuildProjectDirectory)/dist</BuildOutputFolder>
        <!-- `dotnet build` ne relance pas npm à chaque fois ; build front : npm run build -->
        <ShouldRunBuildScript>false</ShouldRunBuildScript>
        <ShouldRunNpmInstall>false</ShouldRunNpmInstall>
    </PropertyGroup>
</Project>
