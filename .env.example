# =====================================================================
#  Synégo : variables d'environnement
#  Copie ce fichier en `.env` puis remplis les valeurs.
#  `.env` est ignoré par git : NE JAMAIS le commiter.
#  Lu par : `dotnet run` (Synégo.Server/Configuration/DotEnv.cs) et `docker compose`.
#  Convention ASP.NET : Section__Cle  =>  Section:Cle dans IConfiguration
# =====================================================================

# ---------- ASP.NET ----------
# Development | Production (docker compose force Production)
ASPNETCORE_ENVIRONMENT=Development

# ---------- Firestore (côté serveur, SDK Admin / Google.Cloud.Firestore) ----------
# Console Firebase > Paramètres du projet > Général > ID du projet
Firestore__ProjectId=ton-projet-firebase
# Laisse "(default)" sauf si tu as créé une base Firestore nommée
Firestore__DatabaseId=(default)
# Console Firebase > Paramètres du projet > Comptes de service > Générer une clé privée
# Place le JSON dans ./secrets/ (dossier ignoré par git). Chemin relatif à ce fichier.
Firestore__CredentialsPath=./secrets/firebase-service-account.json

# ---------- Émulateur Firestore (dev local, aucune donnée réelle) ----------
# Décommente pour utiliser l'émulateur au lieu du vrai projet :
#   docker compose --profile emulator up -d firestore-emulator
# FIRESTORE_EMULATOR_HOST=localhost:8085

# ---------- Docker ----------
# Port exposé sur ta machine par `docker compose up`
SYNEGO_PORT=8080

# ---------- Firebase côté navigateur (optionnel, non utilisé pour l'instant) ----------
# À remplir seulement si le front utilise directement le SDK Firebase JS
# (ex. Firebase Auth / Storage). Ces valeurs sont PUBLIQUES (embarquées dans le JS) :
# la sécurité repose alors sur les règles Firestore/Storage.
# Console Firebase > Paramètres du projet > Vos applications > Config SDK
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=ton-projet-firebase.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=ton-projet-firebase
# VITE_FIREBASE_STORAGE_BUCKET=ton-projet-firebase.firebasestorage.app
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
