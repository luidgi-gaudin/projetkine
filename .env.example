# =====================================================================
#  Synégo : variables d'environnement
#  Copie ce fichier en `.env` puis remplis les valeurs. `.env` est ignoré par git.
#  Lu par : `dotnet run` (Synégo.Server/Configuration/DotEnv.cs), Vite et `docker compose`.
#  Convention ASP.NET : Section__Cle  =>  Section:Cle dans IConfiguration
# =====================================================================

# ---------- ASP.NET ----------
ASPNETCORE_ENVIRONMENT=Development

# ---------- Firebase Authentication (côté serveur) ----------
# Console Firebase > Paramètres du projet > Général > ID du projet
Firebase__ProjectId=ton-projet-firebase
# Premier(s) coach(s) : e-mails (vérifiés) qui deviennent coach à leur connexion.
# Les coachs suivants se nomment depuis le back-office (menu Coachs).
Admin__Emails=gerante@exemple.fr

# ---------- Documents : Firebase Storage ----------
# Local (dev, sans clé) ou Firebase (bucket). Les règles Storage doivent tout refuser au navigateur.
Storage__Provider=Local
Storage__Bucket=ton-projet-firebase.firebasestorage.app
# Console Firebase > Paramètres > Comptes de service > Générer une clé privée (dossier secrets/, ignoré par git)
Storage__CredentialsPath=./secrets/firebase-service-account.json
# Nom du même fichier, pour Docker (le dossier secrets/ est monté dans le conteneur API)
FIREBASE_CREDENTIALS_NAME=firebase-service-account.json

# ---------- Calendly ----------
# Facultatif : la gérante connecte normalement son Calendly depuis le back-office (menu Calendly).
# Ces valeurs ne servent que tant qu'aucun compte n'y est connecté.
CALENDLY_URL_AUDIT=https://calendly.com/votre-compte/audit-seminaire
CALENDLY_URL_DECOUVERTE=https://calendly.com/votre-compte/appel-decouverte
CALENDLY_URL_SUIVI=https://calendly.com/votre-compte/seance-suivi
# Integrations > API & Webhooks > Personal access token (recopie des RDV dans l'espace client)
CALENDLY_TOKEN=
# Clé de signature du webhook (offre Calendly Standard ou plus, facultatif)
CALENDLY_WEBHOOK_KEY=

# ---------- E-mails : rappels de rendez-vous 48 h et 24 h avant ----------
# Vide = les e-mails restent dans Mailpit (http://localhost:8025, ou 10.8.0.1:8025 via le VPN).
# Exemple Brevo (300 e-mails/jour gratuits) : smtp-relay.brevo.com, 587, StartTls
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SECURITY=StartTls
EMAIL_FROM=rendez-vous@synego.fr
EMAIL_REPLY_TO=

# ---------- Connexion par SMS : mode numéros de test (démo, développement) ----------
# true = aucun SMS réel ni reCAPTCHA : uniquement les « numéros de test » déclarés dans
# Firebase > Authentication > Méthodes de connexion > Téléphone. À laisser vide en production.
VITE_FIREBASE_PHONE_TEST_MODE=

# ---------- Docker (./synego.sh init remplit les mots de passe) ----------
# localhost pour tester sur sa machine, le vrai domaine sur le VPS
DOMAIN=localhost
# Ports publics (changer si 80/443 sont déjà pris sur la machine)
HTTP_PORT=80
HTTPS_PORT=443
# true : le back-office du coach n'est joignable que par le VPN (comme la base de données).
# false (défaut) : back-office sur le site, protégé par la connexion et le rôle Coach.
ADMIN_VPN_ONLY=false
# IP du VPN WireGuard sur le VPS : 10.8.0.1 (127.0.0.1 pour tester en local)
ADMIN_BIND_IP=127.0.0.1
# Port de la zone admin sur ADMIN_BIND_IP (défaut 8443 ; install.sh met 8444 si Zabbix utilise déjà 8443)
# ADMIN_PORT=8443
# Générer chaque mot de passe avec : openssl rand -base64 32
POSTGRES_PASSWORD=
SYNEGO_OWNER_PASSWORD=
SYNEGO_APP_PASSWORD=
SYNEGO_BACKUP_PASSWORD=
SYNEGO_READONLY_PASSWORD=
BACKUP_PASSPHRASE=
BACKUP_RETENTION_DAYS=14
BACKUP_DIR=./backups

# ---------- Firebase côté navigateur (valeurs PUBLIQUES, embarquées dans le JS) ----------
# Console Firebase > Paramètres du projet > Vos applications > Config SDK
# VITE_FIREBASE_API_KEY est OBLIGATOIRE : la clé n'est écrite nulle part dans le code (sans elle, pas de connexion).
# Les autres valeurs ont un défaut dans Synego.Client/src/auth/firebase.ts (identifiants publics du projet).
# Authentication > Sign-in method : activer E-mail/Mot de passe, Téléphone et Google.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
