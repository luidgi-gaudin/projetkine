# Requêtes de test (Rider / VS Code REST Client).
# Pour les routes protégées : copier l'ID token Firebase depuis le navigateur
# (DevTools > console : await firebase.auth().currentUser.getIdToken()) dans @token.
@host = http://localhost:5270
@token = colle-ici-un-id-token-firebase

GET {{host}}/api/health

###

GET {{host}}/api/booking/types

###

POST {{host}}/api/contact
Content-Type: application/json

{
  "kind": "Devis",
  "name": "Camille Martin",
  "email": "camille@example.com",
  "company": "ACME",
  "message": "Séminaire d'une journée pour 15 personnes en juin."
}

###

GET {{host}}/api/me
Authorization: Bearer {{token}}

###

GET {{host}}/api/admin/clients
Authorization: Bearer {{token}}
