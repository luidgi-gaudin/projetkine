{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "App": {
    "PublicUrl": ""
  },
  "Email": {
    "Smtp": {
      "Host": "",
      "Port": 587,
      "Username": "",
      "Password": "",
      "Security": "StartTlsWhenAvailable"
    },
    "From": "rendez-vous@synego.fr",
    "FromName": "Synégo",
    "ReplyTo": ""
  },
  "Reminders": {
    "Enabled": true,
    "IntervalMinutes": 5,
    "TimeZone": "Europe/Paris"
  },
  "Stripe": {
    "SecretKey": "",
    "WebhookSecret": "",
    "PaymentLinkDays": 30
  },
  "DataProtection": {
    "KeysPath": "./data/keys"
  },
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=synego;Username=synego_app;Password=change-me;GSS Encryption Mode=Disable"
  },
  "Firebase": {
    "ProjectId": ""
  },
  "Admin": {
    "Emails": ""
  },
  "Security": {
    "RequireAdminZone": false
  },
  "Storage": {
    "Provider": "Local",
    "Bucket": "",
    "CredentialsPath": "",
    "LocalPath": "./data/documents",
    "MaxUploadBytes": 10485760,
    "PurgeAfterDays": 30
  },
  "Booking": {
    "Calendly": {
      "PersonalAccessToken": "",
      "WebhookSigningKey": ""
    },
    "Types": [
      {
        "Key": "audit-seminaire",
        "Title": "Audit séminaire",
        "Summary": "45 minutes en visio pour comprendre votre équipe, vos contraintes et l'effet recherché. Vous repartez avec des pistes concrètes, même si nous ne travaillons pas ensemble.",
        "DurationMinutes": 45,
        "Audience": "Prospect",
        "CalendlyUrl": "https://calendly.com/votre-compte/audit-seminaire"
      },
      {
        "Key": "appel-decouverte",
        "Title": "Appel découverte",
        "Summary": "20 minutes en visio Google Meet pour faire connaissance, parler de votre projet et voir si l'accompagnement vous correspond.",
        "DurationMinutes": 20,
        "Audience": "Prospect",
        "CalendlyUrl": "https://calendly.com/votre-compte/appel-decouverte"
      },
      {
        "Key": "seance-suivi",
        "Title": "Séance de suivi",
        "Summary": "Le rendez-vous régulier des clients accompagnés, en visio : on fait le point, on ajuste le programme, on avance.",
        "DurationMinutes": 60,
        "Audience": "Client",
        "CalendlyUrl": "https://calendly.com/votre-compte/seance-suivi"
      }
    ]
  }
